# Padrão: OpenRouter (free tier) — crie sua chave em https://openrouter.ai/settings/keys
LLM_API_KEY=cole-sua-chave-aqui

# Modelo (opcional): o default é o roteador de modelos gratuitos
# "openrouter/free" (https://openrouter.ai/openrouter/free), que escolhe
# automaticamente um modelo :free a cada requisição. Para fixar um modelo:
# lista em https://openrouter.ai/models?max_price=0 (slug termina em ":free").
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Alternativa local (opcional): Ollama — descomente as duas linhas
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Opcional: só para executar o degrau 02b (contraste Anthropic)
# ANTHROPIC_API_KEY=
